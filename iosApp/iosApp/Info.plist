<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>APTABASE_APP_KEY</key>
	<string>$(APTABASE_APP_KEY)</string>
	<key>WINGMATE_GOOGLE_IOS_CLIENT_ID</key>
	<string>$(WINGMATE_GOOGLE_IOS_CLIENT_ID)</string>
	<key>WINGMATE_MICROSOFT_CLIENT_ID</key>
	<string>$(WINGMATE_MICROSOFT_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.hojmoseit.wingmate.google-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(WINGMATE_GOOGLE_IOS_URL_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.hojmoseit.wingmate.microsoft-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wingmate-auth</string>
			</array>
		</dict>
	</array>
	<key>CKSharingSupported</key>
	<true/>
	<key>OPEN_SYMBOLS_PROXY_URL</key>
	<string>$(OPEN_SYMBOLS_PROXY_URL)</string>
</dict>
</plist>
